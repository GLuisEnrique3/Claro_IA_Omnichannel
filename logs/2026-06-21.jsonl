ctiva, puedes escribir \"escalar a un humano\".", "rag_coleccion": null, "rag_documentos": null, "rag_carrier": null, "latencia_normalizacion_ms": null, "latencia_deteccion_ms": 646, "latencia_entidades_ms": 277, "latencia_sql_ms": 9861, "latencia_bq_ms": 1033, "latencia_rag_ms": null, "latencia_respuesta_ms": 583, "latencia_total_ms": 11480}
